"! Gateway service ZMDG_BP_CR_SRV - Data Provider Class extension (generated by SEGW,
"! redefine the methods below in SE80 / SEGW > Runtime Artifacts > ZCL_ZMDG_BP_CR_DPC_EXT).
"!
"! SEGW entity type ChangeRequest / entity set ChangeRequestSet - see SEGW_ZMDG_BP_CR.md
"!
"! Test in /IWFND/GW_CLIENT (sap-client=120), HTTP POST, Content-Type application/json:
"!   /sap/opu/odata/sap/ZMDG_BP_CR_SRV/ChangeRequestSet
"!   { "CrNumber":"", "CrType":"ZBP1P1", "Description":"AI upload test", "BpCategory":"1",
"!     "Name":"Otto Willy", "Street":"Teststraße", "HouseNumber":"1", "PostalCode":"12345",
"!     "City":"Testhausen", "Country":"DE", "TaxType":"", "TaxNumber":"" }
CLASS zcl_zmdg_bp_cr_dpc_ext DEFINITION PUBLIC INHERITING FROM zcl_zmdg_bp_cr_dpc CREATE PUBLIC.
  PROTECTED SECTION.
    METHODS changerequestset_create_entity REDEFINITION.
    METHODS changerequestset_get_entity    REDEFINITION.
ENDCLASS.


CLASS zcl_zmdg_bp_cr_dpc_ext IMPLEMENTATION.

  " POST ChangeRequestSet -> create MDG CR with prefilled BP data
  METHOD changerequestset_create_entity.
    DATA ls_in TYPE zcl_zmdg_bp_cr_mpc=>ts_changerequest.
    io_data_provider->read_entry_data( IMPORTING es_data = ls_in ).

    IF ls_in-name IS INITIAL.
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING textid  = /iwbep/cx_mgw_busi_exception=>business_error
                  message = 'Name is mandatory'.
    ENDIF.

    TRY.
        DATA(ls_res) = zcl_mdg_bp_cr_create=>create( VALUE #(
                         cr_type      = COND #( WHEN ls_in-crtype IS INITIAL
                                                THEN zcl_mdg_bp_cr_create=>c_cr_type_default
                                                ELSE ls_in-crtype )
                         description  = COND #( WHEN ls_in-description IS INITIAL
                                                THEN |AI upload: { ls_in-name }|
                                                ELSE ls_in-description )
                         bp_category  = COND #( WHEN ls_in-bpcategory IS INITIAL THEN '2' ELSE ls_in-bpcategory )
                         name         = ls_in-name
                         street       = ls_in-street
                         house_number = ls_in-housenumber
                         postal_code  = ls_in-postalcode
                         city         = ls_in-city
                         country      = ls_in-country
                         tax_type     = ls_in-taxtype
                         tax_number   = ls_in-taxnumber
                         bp_temp      = ls_in-bptemp ) ).
      CATCH cx_usmd_conv_som_gov_api cx_usmd_gov_api INTO DATA(lx).
        " Return the MDG messages, not just "An exception was raised."
        DATA(lv_msg) = |{ lx->get_text( ) } | &&
                       |{ zcl_mdg_bp_cr_create=>get_last_error_text( ) }|.
        RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
          EXPORTING textid  = /iwbep/cx_mgw_busi_exception=>business_error
                    message = CONV #( lv_msg ).
    ENDTRY.

    " CR created, but MDG reported errors/warnings -> hand them back to the caller
    IF line_exists( ls_res-messages[ msgty = 'E' ] ).
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING textid  = /iwbep/cx_mgw_busi_exception=>business_error
                  message = CONV #( zcl_mdg_bp_cr_create=>get_last_error_text( ) ).
    ENDIF.

    er_entity = ls_in.
    er_entity-crnumber = ls_res-cr_number.
    er_entity-crtype   = ls_res-cr_type.
    er_entity-crstatus = ls_res-cr_status.
    er_entity-bptemp   = ls_res-bp_temp.
    er_entity-message  = |Change request { ls_res-cr_number } (type { ls_res-cr_type }) created|.
  ENDMETHOD.

  " GET ChangeRequestSet('<CR>') -> read status of a CR (USMD120C)
  METHOD changerequestset_get_entity.
    DATA lv_cr TYPE usmd_crequest.
    READ TABLE it_key_tab INTO DATA(ls_key) WITH KEY name = 'CrNumber'.
    lv_cr = |{ ls_key-value ALPHA = IN }|.

    SELECT SINGLE usmd_crequest, usmd_creq_type, usmd_creq_status, usmd_creq_text
      FROM usmd120c
      WHERE usmd_crequest = @lv_cr
      INTO @DATA(ls_cr).
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING textid  = /iwbep/cx_mgw_busi_exception=>resource_not_found
                  message = |Change request { lv_cr } not found|.
    ENDIF.

    er_entity-crnumber    = ls_cr-usmd_crequest.
    er_entity-crtype      = ls_cr-usmd_creq_type.
    er_entity-crstatus    = ls_cr-usmd_creq_status.
    er_entity-description = ls_cr-usmd_creq_text.
  ENDMETHOD.

ENDCLASS.
