<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="sapUiSmallMargin">
    <Link text="Open original file" href="{= ${previewUrl} ? ${previewUrl}.replace('/preview', '/original') : '' }" target="_blank" class="sapUiSmallMarginBottom"/>
    <Image src="{previewUrl}" width="100%" height="520px" mode="Background" backgroundSize="contain" backgroundPosition="top left"
      alt="Uploaded customer form"/>
  </VBox>
</core:FragmentDefinition>
